<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NativeBin Condition="'$(NativeBin)' == ''">$(MSBuildThisFileDirectory)../.local/native/bin</NativeBin>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ReVision.EyeDevice/ReVision.EyeDevice.csproj" />
    <ProjectReference Include="../ReVision.Streamer/ReVision.Streamer.csproj" />
    <ProjectReference Include="../ReVision.Vive/ReVision.Vive.csproj" />
    <Content Include="$(NativeBin)/*.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
