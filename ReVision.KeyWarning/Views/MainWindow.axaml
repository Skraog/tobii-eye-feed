<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ReVision.KeyWarning.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="200"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Width="600"
        Height="200"
        CanResize="False"
        x:Class="ReVision.KeyWarning.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ReVision.KeyWarning">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" Margin="0 25 0 0">
        <Grid Row="0" HorizontalAlignment="Center">
            <StackPanel MaxWidth="600" HorizontalAlignment="Center">
                <TextBlock Padding="20 0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center">
                    ReVision has detected an EyeChip with additional security features and requires a valid authorization key from the vendor. If you're unable to provide a valid authorization key image streaming will be unavailable.
                </TextBlock>
            </StackPanel>
        </Grid>
        
        <Grid Row="1" HorizontalAlignment="Center" Margin="0 15 0 0">
            <StackPanel Width="400" HorizontalAlignment="Center">
                <TextBox NewLine="" TextWrapping="NoWrap" Watermark="Authorization Key"></TextBox>
            </StackPanel>
        </Grid>
        
        <Grid Row="2" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center" Margin="0 10 0 0">
            <Grid Column="0" Margin="5 0">
                <Button Width="75">
                    <TextBlock TextAlignment="Center">
                        Ok
                    </TextBlock>
                </Button>
            </Grid>
            <Grid Column="1" Margin="5 0">
                <Button Width="75">
                    <TextBlock TextAlignment="Center">
                        Cancel
                    </TextBlock>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
